node_modules/
# /samples/ is the served sample set. It is ignored so a private drawing dropped there for local
# testing can never be committed — EXCEPT the real, properly-licensed demo drawings, which must be
# tracked so a GitHub Pages / CI build can publish them. Everything else in samples/ stays ignored.
/samples/*
!/samples/level-11-floor-plan.pdf
!/samples/waller-estate-floor-plan.pdf
tests/qa/

# local cache of CloudFront log bytes (never committed: it is taken from the owner's own account)
.cache/
_*.mjs
tests/_*.mjs
tools/keepalive.log
tools/server.pid

# AWS deploy toolkit (infra/): local state, scratch files, built lambda zip.
# Never commit these — they are per-machine and the state file is regenerated.
infra/.state
infra/.state.*
infra/.stage/
infra/.tmp/
dist/

# PRIVATE client drawings: this repository is PUBLIC, so these must never be tracked again.
# Keep them on disk for local verification only; tests/samples/sample-plan.pdf (synthetic) is the
# publishable fixture. Removing them from the working tree does not erase them from old commits —
# the user chose not to rewrite history, so treat anything ever committed as public already.
tests/samples/headquarters.pdf
tests/samples/headquarters-scanned.pdf
tests/samples/hq_p*.txt
tests/samples/schedule-sample.pdf
