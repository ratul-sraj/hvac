{
  "type": "module",
  "name": "webhvac",
  "version": "1.0.0",
  "private": true,
  "description": "HVAC cooling-load calculator from PDF floor plans / room schedules (static UI + optional Express server that parses PDFs server-side)",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/run.mjs",
    "test:api": "node tests/api-test.mjs",
    "test:browser": "node tests/browser-check.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "tesseract.js": "^7.0.0"
  }
}
