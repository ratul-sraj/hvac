{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOIDC",
      "Effect": "Allow",
      "Principal": {
        "Federated": "__OIDC_PROVIDER_ARN__"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "__OIDC_PROVIDER_HOST__:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "__OIDC_PROVIDER_HOST__:sub": "__GITHUB_SUB__"
        }
      }
    }
  ]
}
