    "/climates": {
      "get": {
        "tags": [
          "climates"
        ],
        "operationId": "listClimates",
        "summary": "Outdoor design conditions the tool ships, by country and city",
        "description": "Use this to choose honest outDb/outWb rather than assuming them. `countries` is country → city → {db, wb} (°C); `cities` is the same data flattened, city → {db, wb, country} (42 cities, 12 countries).",
        "responses": {
          "200": {
            "description": "countries and cities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Climates"
                },
                "examples": {
                  "live": {
                    "summary": "Real response, abridged to a few cities",
                    "value": {
                      "countries": {
                        "India": {
                          "Kochi": {
                            "db": 35,
                            "wb": 28
                          },
                          "Delhi": {
                            "db": 43,
                            "wb": 24
                          }
                        }
                      },
                      "cities": {
                        "Kochi": {
                          "db": 35,
                          "wb": 28,
                          "country": "India"
                        },
                        "Delhi": {
                          "db": 43,
                          "wb": 24,
                          "country": "India"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parse": {
      "post": {
        "tags": [
          "parse"
        ],
        "operationId": "parseDrawing",
        "summary": "Read rooms from a floor-plan PDF (multipart upload)",
        "description": "Multipart upload of one or more floor-plan PDFs; returns the rooms it can read, per file. Built for a human in a browser — the browser path parses the PDF locally and never uploads it. Agents that already know the room areas should call /calc instead: it is deterministic and does not depend on reading drawing linework. Send files under the field name `files` (or `file`).",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "minItems": 1,
                    "description": "one or more PDFs"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "a single PDF (alternative to `files`)"
                  }
                },
                "description": "Send at least one PDF under `files` (or a single `file`)."
              },
              "examples": {
                "oneFile": {
                  "summary": "Upload one floor plan",
                  "value": {
                    "files": [
                      "level-11-floor-plan.pdf"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rooms read from the drawing(s), per file and flattened.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                },
                "examples": {
                  "live": {
                    "summary": "Real response, abridged to the first file and two rooms",
                    "value": {
                      "files": [
                        {
                          "name": "level-11-floor-plan.pdf",
                          "pages": 1,
                          "rooms": [
                            {
                              "id": "r1",
                              "name": "MEETING ROOM",
                              "level": "L11 Floor",
                              "area": null,
                              "type": "conference",
                              "include": false,
                              "source": "label",
                              "page": 1,
                              "areaUnknown": true,
                              "at": {
                                "x": 653.33,
                                "y": 1118.49
                              },
                              "sourceFile": "level-11-floor-plan.pdf"
                            },
                            {
                              "id": "r2",
                              "name": "MEETING ROOM",
                              "level": "L11 Floor",
                              "area": null,
                              "type": "conference",
                              "include": false,
                              "source": "label",
                              "page": 1,
                              "areaUnknown": true,
                              "at": {
                                "x": 972.52,
                                "y": 1118.49
                              },
                              "sourceFile": "level-11-floor-plan.pdf"
                            }
                          ],
                          "warnings": [
                            "level-11-floor-plan.pdf: Page 1: no printed areas found - 56 room names detected. Their areas are unknown, so they are left out of the load; set each area by tracing the plan or typing it in the table, then tick its Include box."
                          ],
                          "levelCount": 1,
                          "roomCount": 56,
                          "ms": 13
                        }
                      ],
                      "rooms": [
                        {
                          "id": "r1",
                          "name": "MEETING ROOM",
                          "level": "L11 Floor",
                          "area": null,
                          "type": "conference",
                          "include": false,
                          "source": "label",
                          "page": 1,
                          "areaUnknown": true,
                          "at": {
                            "x": 653.33,
                            "y": 1118.49
                          },
                          "sourceFile": "level-11-floor-plan.pdf"
                        },
                        {
                          "id": "r2",
                          "name": "MEETING ROOM",
                          "level": "L11 Floor",
                          "area": null,
                          "type": "conference",
                          "include": false,
                          "source": "label",
                          "page": 1,
                          "areaUnknown": true,
                          "at": {
                            "x": 972.52,
                            "y": 1118.49
                          },
                          "sourceFile": "level-11-floor-plan.pdf"
                        }
                      ],
                      "warnings": [
                        "level-11-floor-plan.pdf: Page 1: no printed areas found - 56 room names detected. Their areas are unknown, so they are left out of the load; set each area by tracing the plan or typing it in the table, then tick its Include box."
                      ],
                      "ms": 13
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No file, or a file that is not a PDF.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "noFile": {
                    "summary": "Real 400 response",
                    "value": {
                      "error": "no file in the request (send one or more files under the field name \"files\")"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "PayloadTooLarge": {
        "description": "Too large: more than 2000 rooms in one /calc call, or an upload past the per-file size limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "tooManyRooms": {
                "summary": "Real /calc 413 response",
                "value": {
                  "error": "too many rooms: 2001 (limit 2000). Split the building across requests."
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request was malformed (e.g. `rooms` was not an array, or the JSON body did not parse).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "notArray": {
                "summary": "Real 400 response",
                "value": {
                  "error": "rooms must be an array"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every error response is this shape: a single `error` string, HTTP status on the response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Room": {
        "type": "object",
        "description": "Only `area` is required. Anything absent is filled from the space-type table and echoed back in results[].room with the same key. Unknown keys are ignored; an unknown `type` falls back to `general`.",
        "required": [
          "area"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "Room",
            "description": "label only; never used in the maths"
          },
          "area": {
            "type": "number",
            "description": "floor area, m² — the dominant input"
          },
          "type": {
            "type": "string",
            "default": "general",
            "enum": [
              "office",
              "conference",
              "cabin",
              "reception",
              "retail",
              "restaurant",
              "bedroom",
              "living",
              "classroom",
              "hospital",
              "server",
              "gym",
              "general"
            ],
            "description": "space type; unknown values fall back to general"
          },
          "height": {
            "type": "number",
            "default": 3,
            "description": "ceiling height, m"
          },
          "people": {
            "type": "integer",
            "description": "occupants; overrides the area-based default"
          },
          "light": {
            "type": "number",
            "description": "lighting, W/m²; per type if absent"
          },
          "equip": {
            "type": "number",
            "description": "equipment/plug load, W/m²; per type if absent"
          },
          "orient": {
            "type": "string",
            "default": "W",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ],
            "description": "facing of the exposed wall"
          },
          "glass": {
            "type": "number",
            "description": "glazing area, m²; overrides the % of exposed wall"
          },
          "extWall": {
            "type": "number",
            "description": "exposed wall area, m²; derived from area if absent"
          },
          "roof": {
            "type": "boolean",
            "default": false,
            "description": "true if this room has an exposed roof"
          },
          "include": {
            "type": "boolean",
            "default": true,
            "description": "false leaves the room out of the total (toilets, shafts)"
          }
        }
      },
      "Project": {
        "type": "object",
        "description": "The design basis. Every field is optional and defaults to general Indian practice — override anything the building actually is, and say which values you used. Note the tool's default wall U (2.0 W/m²K) and roof U (2.0) are starting values; ECBC 2017 (warm-humid) asks for 0.40 and 0.33.",
        "properties": {
          "name": {
            "type": "string",
            "default": "HVAC Load Calculation"
          },
          "country": {
            "type": "string",
            "default": "India"
          },
          "city": {
            "type": "string",
            "default": "Kochi"
          },
          "outDb": {
            "type": "number",
            "default": 35,
            "description": "outdoor design dry bulb, °C"
          },
          "outWb": {
            "type": "number",
            "default": 28,
            "description": "coincident wet bulb, °C"
          },
          "inDb": {
            "type": "number",
            "default": 24,
            "description": "indoor dry bulb, °C"
          },
          "inRh": {
            "type": "number",
            "default": 50,
            "description": "indoor relative humidity, %"
          },
          "uWall": {
            "type": "number",
            "default": 2,
            "description": "W/m²K — 230 mm brick, plastered"
          },
          "uGlass": {
            "type": "number",
            "default": 5.8,
            "description": "W/m²K — single clear glass"
          },
          "sc": {
            "type": "number",
            "default": 0.6,
            "description": "shading coefficient"
          },
          "uRoof": {
            "type": "number",
            "default": 2,
            "description": "W/m²K — RCC slab with waterproofing"
          },
          "roofEtd": {
            "type": "number",
            "default": 22,
            "description": "roof equivalent temperature difference, K"
          },
          "uPart": {
            "type": "number",
            "default": 2.2,
            "description": "partition to non-AC space, W/m²K"
          },
          "infilAch": {
            "type": "number",
            "default": 0.5,
            "description": "air changes per hour"
          },
          "safety": {
            "type": "number",
            "default": 10,
            "description": "safety factor, % (0–100)"
          },
          "supplyDt": {
            "type": "number",
            "default": 11,
            "description": "room minus supply air temperature, K"
          },
          "wwr": {
            "type": "number",
            "default": 30,
            "description": "glazing as % of exposed wall when glass area is absent"
          },
          "units": {
            "type": "string",
            "default": "si",
            "enum": [
              "si",
              "ip"
            ],
            "description": "display only; the maths is always SI"
          }
        }
      },
      "CalcRequest": {
        "type": "object",
        "required": [
          "rooms"
        ],
        "properties": {
          "rooms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/Room"
            },
            "description": "up to 2000 rooms; more is refused with 413"
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          }
        }
      },
      "RoomResult": {
        "type": "object",
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room",
            "description": "the room as the engine used it, with every default filled in"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensible": {
            "type": "object",
            "description": "W: glassSolar, glassCond, wall, roof, partition, people, lighting, equipment, infiltration"
          },
          "latent": {
            "type": "object",
            "description": "W: people, infiltration"
          },
          "rsh": {
            "type": "number",
            "description": "room sensible heat, W"
          },
          "rlh": {
            "type": "number",
            "description": "room latent heat, W"
          },
          "oaSens": {
            "type": "number"
          },
          "oaLat": {
            "type": "number"
          },
          "oaLs": {
            "type": "number",
            "description": "outdoor air, L/s"
          },
          "safetyW": {
            "type": "number"
          },
          "totalW": {
            "type": "number",
            "description": "total cooling load, W"
          },
          "tr": {
            "type": "number",
            "description": "total cooling load, tons of refrigeration"
          },
          "shf": {
            "type": "number",
            "description": "sensible heat factor"
          },
          "supplyLs": {
            "type": "number"
          },
          "supplyOk": {
            "type": "boolean"
          },
          "supplyDt": {
            "type": "number"
          },
          "cfm": {
            "type": "number"
          },
          "oaCfm": {
            "type": "number"
          },
          "totalBtuh": {
            "type": "number"
          },
          "m2PerTr": {
            "type": "number"
          },
          "sqftPerTr": {
            "type": "number"
          }
        }
      },
      "Totals": {
        "type": "object",
        "description": "Project totals: rooms, area, areaSqft, totalW, tr, ls, oaLs, cfm, shf-ish fields, units.",
        "properties": {
          "rooms": {
            "type": "integer"
          },
          "area": {
            "type": "number"
          },
          "areaSqft": {
            "type": "number"
          },
          "totalW": {
            "type": "number"
          },
          "tr": {
            "type": "number"
          },
          "ls": {
            "type": "number"
          },
          "oaLs": {
            "type": "number"
          },
          "cfm": {
            "type": "number"
          },
          "units": {
            "type": "string"
          }
        }
      },
      "CalcResponse": {
        "type": "object",
        "required": [
          "results",
          "warnings",
          "totals"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomResult"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "app",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "app": {
            "type": "string",
            "description": "application name"
          },
          "version": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "uptimeSec": {
            "type": "integer"
          },
          "maxUploadMb": {
            "type": "number"
          },
          "serverSideParse": {
            "type": "boolean"
          }
        }
      },
      "Climates": {
        "type": "object",
        "required": [
          "countries",
          "cities"
        ],
        "properties": {
          "countries": {
            "type": "object",
            "description": "country → { city → {db, wb} }, degrees C",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "db",
                  "wb"
                ],
                "properties": {
                  "db": {
                    "type": "number"
                  },
                  "wb": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "cities": {
            "type": "object",
            "description": "city → {db, wb, country}, the same data flattened",
            "additionalProperties": {
              "type": "object",
              "required": [
                "db",
                "wb",
                "country"
              ],
              "properties": {
                "db": {
                  "type": "number"
                },
                "wb": {
                  "type": "number"
                },
                "country": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ParsedRoom": {
        "type": "object",
        "description": "A room read from a drawing. `area` may be null when no printed area was found; such rooms are flagged (areaUnknown) and left out of the load.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "area": {
            "type": [
              "number",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "include": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "areaUnknown": {
            "type": "boolean"
          },
          "sourceFile": {
            "type": "string"
          }
        }
      },
      "ParseResponse": {
        "type": "object",
        "required": [
          "files",
          "rooms",
          "warnings",
          "ms"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "pages": {
                  "type": "integer"
                },
                "rooms": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ParsedRoom"
                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "levelCount": {
                  "type": "integer"
                },
                "roomCount": {
                  "type": "integer"
                },
                "ms": {
                  "type": "number"
                }
              }
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParsedRoom"
            },
            "description": "all rooms across all files, flattened"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ms": {
            "type": "number",
            "description": "slowest file, ms"
          }
        }
      }
    }
  }
}
