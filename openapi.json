{
  "openapi": "3.1.0",
  "info": {
    "title": "LoadLens API — cooling load calculation",
    "version": "1.0.0",
    "summary": "Design cooling load (TR) from room areas and space types, with the full design basis returned. Free, no API key.",
    "description": "LoadLens turns room dimensions and space types into a design cooling load in tons of refrigeration (TR), with the design basis returned alongside every figure so the number can be checked. It is **free and needs no API key**, no account and no cookie. It runs on **AWS** (Lambda behind a Function URL / API Gateway) and is served from https://loadlens.net. One call may carry a building of **up to 2000 rooms**; more is refused with HTTP 413 rather than truncated. This HTTP API is for **agents and programmatic use**: the tool's browser path (/app.html) reads a floor-plan PDF entirely in the browser and **never uploads the PDF** to a server — POST /parse here is the optional server-side parse, for a caller that has a PDF and no browser. This is a first-estimate / design-stage check, not a substitute for a stamped HAP or Trace calculation; say so if you pass its numbers on. Long form for agents: https://loadlens.net/llms.txt",
    "contact": {
      "name": "Ratul S Raj",
      "email": "ratul.sraj@gmail.com",
      "url": "https://loadlens.net/method.html"
    },
    "license": {
      "name": "Source available",
      "url": "https://github.com/ratul-sraj/hvac"
    }
  },
  "servers": [
    {
      "url": "https://loadlens.net/api",
      "description": "production — the static site and this API share the host; no key required"
    }
  ],
  "tags": [
    {
      "name": "calc",
      "description": "Cooling load from rooms"
    },
    {
      "name": "climates",
      "description": "Outdoor design conditions the tool ships"
    },
    {
      "name": "parse",
      "description": "Server-side floor-plan PDF parsing (optional; browser path never uploads)"
    },
    {
      "name": "health",
      "description": "Liveness"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "health",
        "summary": "Liveness check",
        "description": "Cheap liveness probe. Returns the app name, version and runtime facts.",
        "responses": {
          "200": {
            "description": "The service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "examples": {
                  "live": {
                    "summary": "Real response from a running server",
                    "value": {
                      "ok": true,
                      "app": "LoadLens",
                      "version": "1.0.0-server",
                      "node": "v22.23.2",
                      "uptimeSec": 7110,
                      "maxUploadMb": 25,
                      "serverSideParse": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/calc": {
      "post": {
        "tags": [
          "calc"
        ],
        "operationId": "calculateLoad",
        "summary": "Cooling load for one or more rooms (up to 2000 per call)",
        "description": "Give rooms; get back per-room sensible/latent breakdown, per-room TR and project totals. Absent room fields are filled from the space-type table and the filled values are **echoed back in results[].room**, so the basis of every number is visible — read that echo instead of assuming. Units: W for power, TR for cooling load, L/s for airflow (CFM and *Btuh fields also returned). More than 2000 rooms is refused with 413.",
